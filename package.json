{
  "name": "sertifdigital-informatika",
  "version": "0.1.0",
  "description": "Web App Manajemen Sertifikat Digital - Program Studi Informatika & HMP Universitas Tiga Serangkai",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n APP,CSS -c blue,yellow \"npm:dev:app\" \"npm:css:watch\"",
    "dev:app": "node --watch-path=src --watch-preserve-output src/server.js",
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --watch",
    "build": "npm run css:build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "fabric": "^7.4.0",
    "fontkit": "^2.0.4",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
