# ==== App ====
NODE_ENV=development
PORT=3000
APP_NAME="SertifDigital Informatika TSU"
APP_URL=http://localhost:3000
# Set ke 1 jika berjalan di belakang reverse proxy (nginx/Laragon/ngrok)
TRUST_PROXY=0

# ==== Session / Security (diisi di Tahap 2) ====
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Secret HMAC untuk tanda tangan QR Code anti-pemalsuan (Tahap 3)
QR_SIGNING_SECRET=ganti-dengan-string-acak-panjang-lain

# ==== Database (Prisma + PostgreSQL) ====
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/sertifdigital?schema=public"

# ==== Google OAuth 2.0 (Tahap 2) ====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ==== Email / Nodemailer (Tahap 3) - default: Mailpit bawaan Laragon ====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Prodi Informatika TSU <no-reply@tsu.ac.id>"

# ==== Rate limit ====
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_MAX=30

# ==== Seeder Super Admin (npm run db:seed) ====
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_EMAIL=superadmin@tsu.ac.id
SEED_SUPERADMIN_PASSWORD=ganti-dengan-password-kuat

# Admin Prodi (role ADMIN, selevel Kaprodi). Password kosong = sama dengan Super Admin
SEED_ADMINPRODI_NAME="Admin Prodi Informatika"
SEED_ADMINPRODI_EMAIL=adminprodi@tsu.ac.id
SEED_ADMINPRODI_PASSWORD=

# Opsional: batasi login Google hanya domain tertentu (kosongkan untuk semua domain)
GOOGLE_ALLOWED_DOMAIN=tsu.ac.id
