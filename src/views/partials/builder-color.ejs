<%# Baris warna builder: color picker + kode HEX + pipet (logika di public/js/pages/builder.js) %>
<div class="<%= typeof cls !== 'undefined' ? cls : '' %>" data-color-row>
  <span class="text-xs font-medium text-slate-600"><%= typeof label !== 'undefined' ? label : 'Warna' %></span>
  <div class="mt-1 flex items-center gap-1.5">
    <input type="color" name="<%= typeof name !== 'undefined' ? name : 'color' %>" aria-label="Pilih warna" class="block h-9 w-11 shrink-0 cursor-pointer rounded-lg border border-slate-300 bg-white p-1">
    <input type="text" data-hex maxlength="7" spellcheck="false" autocomplete="off" aria-label="Kode warna HEX" placeholder="#000000" class="form-input min-w-0 flex-1 py-1.5 font-mono text-sm uppercase">
    <button type="button" data-eyedropper class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-600 hover:border-tsu-400 hover:bg-tsu-50 hover:text-tsu-700 disabled:cursor-not-allowed disabled:opacity-40" title="Ambil warna dengan pipet" aria-label="Ambil warna dengan pipet">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 22 1-1h3l9-9"/><path d="M3 21v-3l9-9"/><path d="m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z"/></svg>
    </button>
  </div>
</div>
