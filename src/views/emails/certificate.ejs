<!DOCTYPE html>
<html lang="id">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Sertifikat <%= eventTitle %></title></head>
<body style="margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;">
        <tr><td style="background:<%= brand.primary[800] %>;border-bottom:4px solid <%= brand.accent[400] %>;padding:20px 28px;">
          <% if (brand.logoUrl) { %><img src="<%= appUrl %><%= brand.logoUrl %>" alt="" height="36" style="height:36px;vertical-align:middle;background:#ffffff;border-radius:6px;padding:3px;"><% } else { %><span style="display:inline-block;background:<%= brand.accent[400] %>;color:<%= brand.primary[900] %>;font-weight:800;padding:6px 10px;border-radius:6px;"><%= brand.logoText %></span><% } %>
          <span style="color:#ffffff;font-weight:700;font-size:16px;margin-left:8px;vertical-align:middle;"><%= brand.appName %></span>
        </td></tr>
        <tr><td style="padding:28px;">
          <p style="margin:0 0 12px;font-size:15px;">Halo <strong><%= participantName %></strong>,</p>
          <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">
            Terima kasih telah berpartisipasi sebagai <strong><%= participantRole %></strong> pada kegiatan
            <strong><%= eventTitle %></strong> (<%= eventDate %>). Sertifikat Anda terlampir pada email ini.
          </p>
          <table role="presentation" cellpadding="0" cellspacing="0" style="background:<%= brand.primary[50] %>;border-radius:8px;width:100%;margin:0 0 20px;">
            <tr><td style="padding:14px 16px;font-size:13px;color:#334155;">
              Nomor Sertifikat<br><strong style="font-size:15px;color:<%= brand.primary[800] %>;"><%= certificateNumber %></strong>
            </td></tr>
          </table>
          <table role="presentation" cellpadding="0" cellspacing="0"><tr>
            <% if (downloadUrl) { %>
            <td style="border-radius:8px;background:<%= brand.primary[700] %>;"><a href="<%= downloadUrl %>" style="display:inline-block;padding:12px 20px;color:#ffffff;text-decoration:none;font-weight:700;font-size:14px;">Unduh Sertifikat</a></td>
            <td style="width:8px;"></td>
            <% } %>
            <td style="border-radius:8px;border:1px solid <%= brand.primary[200] %>;"><a href="<%= verifyUrl %>" style="display:inline-block;padding:11px 18px;color:<%= brand.primary[700] %>;text-decoration:none;font-weight:700;font-size:14px;">Cek Keaslian</a></td>
          </tr></table>
          <p style="margin:24px 0 0;font-size:12px;color:#64748b;line-height:1.6;">
            Keaslian sertifikat dapat diverifikasi kapan saja dengan memindai QR Code pada sertifikat.
            Email ini dikirim otomatis, mohon tidak membalas.
          </p>
        </td></tr>
        <tr><td style="background:<%= brand.primary[950] %>;color:<%= brand.primary[200] %>;font-size:12px;padding:14px 28px;">
          <%= brand.footerCopyright %><% if (brand.contactEmail) { %> &middot; <%= brand.contactEmail %><% } %>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
