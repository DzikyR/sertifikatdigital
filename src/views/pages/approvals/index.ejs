<%- include('../../partials/app/start', { pageTitle: 'Persetujuan Draf HMP', pageSubtitle: 'Periksa template, layout, dan daftar peserta sebelum menyetujui penerbitan sertifikat.' }) %>

<section aria-labelledby="pending-title">
  <h2 id="pending-title" class="mb-3 font-bold text-slate-900">Menunggu Keputusan (<%= pending.length %>)</h2>
  <% if (!pending.length) { %>
    <div class="card flex items-center gap-3 text-sm text-slate-600">
      <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
      Tidak ada draf yang menunggu persetujuan.
    </div>
  <% } else { %>
    <div class="grid gap-4 md:grid-cols-2">
      <% pending.forEach((e) => { const base = `/api/events/${e.id}`; %>
        <article class="card flex flex-col border-l-4 border-l-gold-400">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="truncate font-bold text-slate-900"><a href="/events/<%= e.id %>" class="hover:text-tsu-700"><%= e.title %></a></h3>
              <p class="mt-0.5 text-sm text-slate-500"><%= fmtDate(e.eventDate) %> &middot; oleh <%= e.createdBy.name %></p>
            </div>
            <span class="badge shrink-0 ring-1 <%= EVENT_STATUS_META.PENDING_APPROVAL.cls %>">Diajukan <%= fmtDateTime(e.submittedAt) %></span>
          </div>
          <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-lg bg-slate-50 p-3"><dt class="text-slate-500">Peserta</dt><dd class="text-lg font-bold tabular-nums"><%= fmtNumber(e._count.certificates) %></dd></div>
            <div class="rounded-lg bg-slate-50 p-3"><dt class="text-slate-500">Tanda tangan</dt><dd class="text-lg font-bold tabular-nums"><%= e._count.signatures %></dd></div>
          </dl>
          <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
            <a href="<%= base %>/preview" target="_blank" rel="noopener" class="btn btn-outline">Preview PDF</a>
            <a href="/events/<%= e.id %>#peserta" class="btn btn-outline">Peserta</a>
            <span class="flex-1"></span>
            <button class="btn bg-red-600 text-white hover:bg-red-700" data-action="POST <%= base %>/reject" data-prompt="Alasan penolakan" data-prompt-required data-danger data-confirm-title="Tolak draf?" data-confirm="Pengurus HMP akan melihat alasan ini dan dapat merevisi draf." data-ok-label="Tolak">Tolak</button>
            <button class="btn btn-primary" data-action="POST <%= base %>/approve" data-prompt="Catatan (opsional)" data-confirm-title="Setujui draf?" data-confirm="Setelah disetujui, pengurus HMP dapat menerbitkan dan mengirim sertifikat." data-ok-label="Setujui">Setujui</button>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="mt-10" aria-labelledby="history-title">
  <h2 id="history-title" class="mb-3 font-bold text-slate-900">Riwayat Keputusan</h2>
  <div class="card overflow-hidden p-0">
    <% if (!history.length) { %>
      <p class="p-6 text-sm text-slate-500">Belum ada riwayat.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
            <tr><th class="px-5 py-3">Kegiatan</th><th class="px-5 py-3">Status saat ini</th><th class="px-5 py-3">Diputuskan</th><th class="px-5 py-3">Catatan</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% history.forEach((e) => { const m = EVENT_STATUS_META[e.status]; %>
              <tr class="hover:bg-slate-50">
                <td class="px-5 py-3"><a href="/events/<%= e.id %>" class="font-semibold text-slate-900 hover:text-tsu-700"><%= e.title %></a><p class="text-xs text-slate-500">oleh <%= e.createdBy.name %></p></td>
                <td class="px-5 py-3"><span class="badge ring-1 <%= m.cls %>"><%= m.label %></span></td>
                <td class="whitespace-nowrap px-5 py-3 text-slate-600"><%= fmtDateTime(e.reviewedAt) %><p class="text-xs text-slate-500"><%= e.reviewedBy?.name %></p></td>
                <td class="max-w-xs truncate px-5 py-3 text-slate-600" title="<%= e.reviewNote || '' %>"><%= e.reviewNote || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<%- include('../../partials/app/end') %>
