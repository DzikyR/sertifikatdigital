<%
  const managed = ['ADMIN', 'HMP'];
  const toggle = (key, role, on, label) => `
    <label class="relative inline-flex cursor-pointer items-center" title="${label}">
      <input type="checkbox" class="peer sr-only" data-feature-toggle data-key="${key}" data-role="${role}" ${on ? 'checked' : ''} aria-label="${label}">
      <span class="h-6 w-11 rounded-full bg-slate-300 transition peer-checked:bg-tsu-600 peer-focus-visible:ring-2 peer-focus-visible:ring-tsu-500 peer-focus-visible:ring-offset-2 peer-disabled:opacity-50"></span>
      <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
    </label>`;
%>
<%- include('../../partials/app/start', { pageTitle: 'Fitur & Akses', pageSubtitle: 'Aktifkan atau nonaktifkan fitur untuk setiap role. Perubahan langsung berlaku tanpa perlu restart.',
  actions: '<button type="button" class="btn btn-outline" data-action="POST /api/admin/features/reset" data-confirm="Semua fitur akan diaktifkan kembali untuk semua role." data-confirm-title="Kembalikan ke default?" data-ok-label="Kembalikan">Kembalikan ke Default</button>' }) %>

<div class="mb-6 grid gap-3 text-sm md:grid-cols-3">
  <div class="rounded-xl border border-tsu-100 bg-tsu-50 p-4 text-tsu-900">
    <p class="font-semibold">Super Admin selalu memiliki akses penuh</p>
    <p class="mt-1 text-tsu-800">Pengaturan ini tidak membatasi Super Admin, sehingga sistem tidak bisa terkunci.</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 text-slate-700">
    <p class="font-semibold">Berlaku di tampilan &amp; server</p>
    <p class="mt-1 text-slate-600">Tombol fitur yang dimatikan disembunyikan, dan permintaan langsung ke API juga ditolak.</p>
  </div>
  <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-900">
    <p class="font-semibold">Verifikasi QR selalu aktif</p>
    <p class="mt-1 text-amber-800">Halaman verifikasi tidak bisa dimatikan agar sertifikat yang sudah tercetak tetap bisa dicek keasliannya.</p>
  </div>
</div>

<% groups.filter((g) => !g.global).forEach((g) => { %>
  <section class="card mb-6 overflow-hidden p-0" aria-labelledby="g-<%= g.name %>">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50">
          <tr>
            <th id="g-<%= g.name %>" class="px-5 py-3 text-sm font-bold text-slate-900"><%= g.name %></th>
            <% managed.forEach((r) => { %><th class="w-44 px-5 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500"><%= roles[r] %></th><% }) %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% g.items.forEach((f) => { %>
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-3.5 text-slate-800"><%= f.label %><span class="mt-0.5 block font-mono text-xs text-slate-400"><%= f.key %></span></td>
              <% managed.forEach((r) => { %>
                <td class="px-5 py-3.5 text-center">
                  <% if (f.values[r] === null) { %><span class="text-xs text-slate-400" title="Tidak berlaku untuk role ini">Tidak berlaku</span>
                  <% } else { %><%- toggle(f.key, r, f.values[r], `${f.label} untuk ${roles[r]}`) %><% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% }) %>

<div class="grid gap-6 lg:grid-cols-2">
  <% groups.filter((g) => g.global).forEach((g) => { %>
    <section class="card p-0" aria-labelledby="g-<%= g.name %>">
      <h2 id="g-<%= g.name %>" class="border-b border-slate-200 bg-slate-50 px-5 py-3 text-sm font-bold text-slate-900"><%= g.name %> <span class="ml-1 text-xs font-normal text-slate-500">(berlaku untuk semua pengguna)</span></h2>
      <ul class="divide-y divide-slate-100">
        <% g.items.forEach((f) => { %>
          <li class="flex items-center gap-4 px-5 py-4">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-slate-800"><%= f.label %></p>
              <% if (f.description) { %><p class="mt-0.5 text-xs text-slate-500"><%= f.description %></p><% } %>
            </div>
            <%- toggle(f.key, 'GLOBAL', f.values.GLOBAL, f.label) %>
          </li>
        <% }) %>
      </ul>
    </section>
  <% }) %>
</div>

<%- include('../../partials/app/end') %>
