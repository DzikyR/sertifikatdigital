<%- include('../../partials/head') %>
<%- include('../../partials/navbar') %>

<main class="flex-1">
  <section class="bg-gradient-to-br from-tsu-800 via-tsu-700 to-tsu-900 px-4 pb-24 pt-12 text-white sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-extrabold sm:text-4xl">Cari Sertifikat Anda</h1>
      <p class="mt-3 text-tsu-100">Masukkan email yang Anda gunakan saat mendaftar kegiatan, atau nomor sertifikat.</p>
    </div>
  </section>

  <section class="mx-auto -mt-16 max-w-3xl px-4 pb-16 sm:px-6">
    <form method="get" action="/cari" class="card p-4 shadow-lg sm:p-6" role="search">
      <label for="q" class="form-label">Email atau Nomor Sertifikat</label>
      <div class="flex flex-col gap-3 sm:flex-row">
        <input id="q" name="q" value="<%= q %>" required minlength="5" maxlength="191" autocomplete="email" autofocus
               class="form-input flex-1 py-3 text-base" placeholder="nama@email.com atau INF/XXXXX/2026/0001">
        <button class="btn btn-primary px-6 py-3">Cari</button>
      </div>
      <p class="mt-2 text-xs text-slate-500">Data pribadi disamarkan. Hanya sertifikat yang telah diterbitkan dan valid yang ditampilkan.</p>
    </form>

    <% if (error) { %>
      <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" role="alert"><%= error %></div>
    <% } else if (results) { %>
      <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-slate-500" aria-live="polite">
        <%= results.length ? `${results.length} sertifikat ditemukan` : 'Tidak ada hasil' %>
      </h2>
      <% if (!results.length) { %>
        <div class="card mt-3 text-center">
          <p class="font-semibold text-slate-900">Sertifikat tidak ditemukan</p>
          <p class="mt-1 text-sm text-slate-500">Pastikan email sama persis dengan yang didaftarkan ke panitia, atau hubungi penyelenggara kegiatan.</p>
        </div>
      <% } %>
      <ul class="mt-3 space-y-3">
        <% results.forEach((c) => { %>
          <li class="card flex flex-col gap-4 p-5 sm:flex-row sm:items-center">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gold-100 text-gold-700" aria-hidden="true">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" /></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-slate-900"><%= c.event.title %></p>
              <p class="text-sm text-slate-600"><%= c.participantName %> &middot; <%= c.participantRole %></p>
              <p class="mt-1 text-xs text-slate-500"><%= c.event.dateText %> &middot; <%= c.event.organizer %> &middot; <span class="font-mono"><%= c.certificateNumber %></span></p>
            </div>
            <div class="flex gap-2">
              <a href="<%= c.verifyPath %>" class="btn btn-outline">Detail</a>
              <% if (c.downloadUrl) { %><a href="<%= c.downloadUrl %>" class="btn btn-primary">Unduh PDF</a><% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <div class="mt-10 rounded-2xl border border-tsu-100 bg-tsu-50 p-5 text-sm text-tsu-900">
      <p class="font-semibold">Ingin memeriksa keaslian sertifikat orang lain?</p>
      <p class="mt-1 text-tsu-800">Pindai QR Code pada sertifikat dengan kamera ponsel, atau <a href="/verify" class="font-semibold underline">masukkan kode verifikasi</a>.</p>
    </div>
  </section>
</main>

<%- include('../../partials/footer') %>
