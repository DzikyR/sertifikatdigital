<%
  const p = event.permissions;
  const meta = EVENT_STATUS_META[event.status];
  const base = `/api/events/${event.id}`;
  const isHmpEvent = event.organizerType === 'HMP';
  const steps = isHmpEvent
    ? [['DRAFT', 'Draf'], ['PENDING_APPROVAL', 'Diajukan'], ['APPROVED', 'Disetujui'], ['PUBLISHED', 'Terbit']]
    : [['DRAFT', 'Draf'], ['PUBLISHED', 'Terbit']];
  const order = steps.map((s) => s[0]);
  const currentIdx = event.status === 'REJECTED' ? 0 : order.indexOf(event.status);
  const email = event.stats.email;
  const issued = event.status === 'PUBLISHED';
  const json = (o) => JSON.stringify(o);

  let actions = '';
  if (p.submit) actions += `<button class="btn btn-accent" data-action="POST ${base}/submit" data-confirm="Setelah diajukan, template, TTD, layout dan peserta terkunci sampai Kaprodi memberi keputusan." data-confirm-title="Ajukan ke Kaprodi?" data-ok-label="Ajukan">Ajukan ke Kaprodi</button>`;
  if (p.review) {
    actions += `<button class="btn bg-red-600 text-white hover:bg-red-700" data-action="POST ${base}/reject" data-prompt="Alasan penolakan" data-prompt-required data-danger data-confirm="Pengurus HMP akan melihat alasan ini dan dapat merevisi draf." data-confirm-title="Tolak draf?" data-ok-label="Tolak">Tolak</button>`;
    actions += `<button class="btn btn-primary" data-action="POST ${base}/approve" data-prompt="Catatan (opsional)" data-confirm="Setelah disetujui, sertifikat dapat diterbitkan dan dikirim ke peserta." data-confirm-title="Setujui draf?" data-ok-label="Setujui">Setujui</button>`;
  }
  if (p.publish) {
    actions += `<button class="btn btn-outline" data-action="POST ${base}/publish" data-body='${json({ issueAll: false })}' data-confirm="Template, layout & data peserta dikunci. Belum ada sertifikat yang terbit; Anda memilih sendiri peserta yang diterbitkan di tab Peserta. Email tidak dikirim otomatis." data-confirm-title="Kunci & pilih peserta?" data-ok-label="Kunci event">Kunci &amp; Pilih Peserta</button>`;
    actions += `<button class="btn btn-accent" data-preview-issue="all" data-url="${base}/publish" data-body='${json({ issueAll: true })}' data-total="${event.stats.participants}" data-confirm-label="Terbitkan semua">Terbitkan Semua</button>`;
  }
  if (p.unlock) {
    const st = event.stats.issue;
    const conseq = event.status === 'PUBLISHED'
      ? `Event kembali menjadi Draf sehingga template, layout & data peserta bisa diperbaiki. ${st.issued + st.revoked} sertifikat yang sudah terbit DITARIK dari akses publik (QR akan menampilkan "belum diterbitkan") sampai diterbitkan ulang; nomor & QR tetap sama. Status email direset, kirim ulang setelah diperbaiki.`
      : 'Event kembali menjadi Draf sehingga template, layout & data peserta bisa diperbaiki. Event HMP perlu diajukan & disetujui ulang.';
    actions += `<button class="btn btn-outline text-red-700 ring-red-200" data-action="POST ${base}/unlock" data-prompt="Alasan membuka kunci" data-prompt-required data-danger data-confirm="${conseq.replace(/"/g, '&quot;')}" data-confirm-title="Buka kunci event?" data-ok-label="Buka kunci"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>Buka Kunci</button>`;
  }
%>
<%- include('../../partials/app/start') %>

<!-- Header -->
<div class="mt-2 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <span class="badge ring-1 <%= meta.cls %>"><%= meta.label %></span>
      <span class="badge <%= isHmpEvent ? 'bg-gold-50 text-gold-700' : 'bg-tsu-50 text-tsu-700' %>"><%= ORGANIZER_LABELS[event.organizerType] %></span>
    </div>
    <h1 class="mt-2 text-2xl font-bold text-slate-900"><%= event.title %></h1>
    <% if (event.theme) { %><p class="mt-1 text-base italic text-tsu-800">Tema: &ldquo;<%= event.theme %>&rdquo;</p><% } %>
    <p class="mt-1 text-sm text-slate-500"><%= fmtDate(event.eventDate) %><%= event.location ? ` · ${event.location}` : '' %> · dibuat oleh <%= event.createdBy.name %></p>
  </div>
  <div class="flex flex-wrap gap-2"><%- actions %></div>
</div>

<!-- Stepper -->
<ol class="mt-6 flex items-center gap-2 overflow-x-auto text-sm" aria-label="Tahapan">
  <% steps.forEach(([key, label], i) => { const done = i < currentIdx || (issued && i === currentIdx); const now = i === currentIdx && !issued; %>
    <% if (i) { %><li aria-hidden="true" class="h-px w-8 shrink-0 <%= i <= currentIdx ? 'bg-tsu-500' : 'bg-slate-300' %>"></li><% } %>
    <li class="flex shrink-0 items-center gap-2 <%= now ? 'font-semibold text-tsu-800' : done ? 'text-slate-700' : 'text-slate-400' %>" <%= now ? 'aria-current=step' : '' %>>
      <span class="flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold <%= done ? 'bg-tsu-700 text-white' : now ? 'bg-gold-400 text-tsu-950' : 'bg-slate-200 text-slate-500' %>">
        <% if (done) { %><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg><% } else { %><%= i + 1 %><% } %>
      </span>
      <%= label %>
    </li>
  <% }) %>
</ol>

<% if (event.status === 'REJECTED' && event.reviewNote) { %>
  <div class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900" role="alert">
    <p class="font-semibold">Ditolak oleh <%= event.reviewedBy?.name || 'Kaprodi' %> &middot; <%= fmtDateTime(event.reviewedAt) %></p>
    <p class="mt-1 whitespace-pre-line"><%= event.reviewNote %></p>
    <p class="mt-2 text-red-700">Perbaiki draf, lalu klik <strong>Ajukan ke Kaprodi</strong> kembali.</p>
  </div>
<% } else if (event.status === 'PENDING_APPROVAL') { %>
  <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    Diajukan <%= fmtDateTime(event.submittedAt) %>. <%= p.review ? 'Periksa preview PDF dan daftar peserta sebelum memberi keputusan.' : 'Menunggu keputusan Kaprodi. Draf terkunci sementara.' %>
    <a href="<%= base %>/preview" target="_blank" rel="noopener" class="ml-1 font-semibold underline">Lihat preview PDF</a>
  </div>
<% } else if (event.status === 'DRAFT' && event.reviewNote) { %>
  <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" role="status">
    <p class="font-semibold">Kunci dibuka oleh <%= event.reviewedBy?.name || 'Kaprodi' %> &middot; <%= fmtDateTime(event.reviewedAt) %></p>
    <p class="mt-1 whitespace-pre-line"><%= event.reviewNote %></p>
    <p class="mt-2 text-amber-800">Perbaiki data yang salah, periksa pratinjau, lalu <%= isHmpEvent ? 'ajukan kembali ke Kaprodi' : 'terbitkan kembali' %>. Sertifikat yang tadinya terbit belum dapat diakses publik sampai diterbitkan ulang.</p>
  </div>
<% } else if (event.status === 'APPROVED' && event.reviewNote) { %>
  <div class="mt-5 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900">Disetujui <%= event.reviewedBy?.name %>: <%= event.reviewNote %></div>
<% } %>

<% if (p.edit || p.submit || p.publish) { %>
  <% if (!event.readiness.ready) { %>
    <div class="mt-5 rounded-xl border border-slate-200 bg-white p-4 text-sm">
      <p class="font-semibold text-slate-900">Lengkapi sebelum <%= isHmpEvent ? 'diajukan' : 'diterbitkan' %>:</p>
      <ul class="mt-2 space-y-1 text-slate-600">
        <% event.readiness.problems.forEach((m) => { %><li class="flex gap-2"><span class="text-gold-600" aria-hidden="true">●</span><%= m %></li><% }) %>
      </ul>
    </div>
  <% } %>
<% } %>

<!-- Tabs -->
<div class="mt-6" data-tabs>
  <div class="flex gap-1 overflow-x-auto border-b border-slate-200" role="tablist">
    <% [['template', 'Template & TTD'], ['peserta', `Peserta (${event.stats.participants})`], ['info', 'Info Event']].forEach(([k, l]) => { %>
      <button type="button" role="tab" data-tab="<%= k %>" class="-mb-px whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 text-sm font-semibold text-slate-500 hover:text-tsu-700"><%= l %></button>
    <% }) %>
  </div>

  <!-- TAB: Template & TTD -->
  <section data-tab-panel="template" class="grid gap-6 pt-6 lg:grid-cols-5">
    <div class="card lg:col-span-3">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-bold text-slate-900">Template Sertifikat</h2>
        <div class="flex gap-2">
          <% if (event.hasTemplate) { %><a href="<%= base %>/preview" target="_blank" rel="noopener" class="btn btn-outline">Preview PDF</a><% } %>
          <% if (event.hasTemplate) { %><a href="/events/<%= event.id %>/builder" class="btn btn-primary"><%= p.editLayout ? 'Buka Builder' : 'Lihat Layout' %></a><% } %>
        </div>
      </div>
      <% if (event.hasTemplate) { %>
        <img src="<%= event.templateUrl %>" alt="Template sertifikat" class="mt-4 w-full rounded-lg border border-slate-200" loading="lazy">
        <p class="mt-2 text-xs text-slate-500">Ukuran asli <%= event.templateWidth %> &times; <%= event.templateHeight %> px</p>
      <% } else { %>
        <div class="mt-4 flex h-48 items-center justify-center rounded-lg border-2 border-dashed border-slate-300 text-sm text-slate-500">Belum ada template</div>
      <% } %>
      <% if (p.editTemplate) { %>
        <form class="mt-4 flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4" data-upload-form data-url="<%= base %>/template" data-field="template">
          <input type="file" name="template" accept="image/png,image/jpeg" required class="text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-tsu-50 file:px-3 file:py-2 file:font-semibold file:text-tsu-700 hover:file:bg-tsu-100">
          <button class="btn btn-outline"><%= event.hasTemplate ? 'Ganti Template' : 'Unggah Template' %></button>
          <p class="w-full text-xs text-slate-500">PNG/JPG kosong (tanpa nama), maks. 10 MB, sisi terpanjang minimal 600 px. Disarankan A4 landscape 3508 &times; 2480 px.</p>
        </form>
      <% } %>
    </div>

    <div class="space-y-6 lg:col-span-2">
    <div class="card">
      <h2 class="font-bold text-slate-900">Tanda Tangan (<%= event.signatures.length %>)</h2>
      <p class="mt-1 text-sm text-slate-500">Unggah PNG transparan per penandatangan, lalu atur posisinya di Builder.</p>
      <ul class="mt-4 space-y-3">
        <% if (!event.signatures.length) { %><li class="rounded-lg border border-dashed border-slate-300 p-4 text-center text-sm text-slate-500">Belum ada tanda tangan.</li><% } %>
        <% event.signatures.forEach((s) => { %>
          <li class="flex items-center gap-3 rounded-lg border border-slate-200 p-3">
            <img src="<%= s.imageUrl %>" alt="TTD <%= s.label %>" class="h-12 w-20 rounded bg-[repeating-conic-gradient(#f1f5f9_0_25%,#fff_0_50%)] bg-[length:12px_12px] object-contain">
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-slate-900"><%= s.label %></p>
              <p class="truncate text-xs text-slate-500"><%= [s.signerName, s.signerTitle].filter(Boolean).join(' · ') || 'Tanpa keterangan nama' %></p>
            </div>
            <% if (p.editTemplate) { %>
              <button class="rounded-md p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600" data-action="DELETE <%= base %>/signatures/<%= s.id %>" data-confirm="Hapus tanda tangan &quot;<%= s.label %>&quot;?" data-danger data-ok-label="Hapus" aria-label="Hapus TTD <%= s.label %>">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
              </button>
            <% } %>
          </li>
        <% }) %>
      </ul>
      <% if (p.editTemplate) { %>
        <form class="mt-4 space-y-3 border-t border-slate-100 pt-4" data-upload-form data-url="<%= base %>/signatures" data-field="image">
          <div>
            <label class="form-label" for="sig-label">Label <span class="text-red-600">*</span></label>
            <input id="sig-label" name="label" required maxlength="100" class="form-input" placeholder="mis. Kaprodi / Ketua HMP / Pembicara">
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div><label class="form-label" for="sig-name">Nama penandatangan</label><input id="sig-name" name="signerName" maxlength="150" class="form-input" placeholder="Dr. Nama, M.Kom."></div>
            <div><label class="form-label" for="sig-title">Jabatan / NIP</label><input id="sig-title" name="signerTitle" maxlength="150" class="form-input" placeholder="Ketua Program Studi"></div>
          </div>
          <label class="flex items-center gap-2 text-sm text-slate-600"><input type="checkbox" name="showSignerText" checked class="rounded border-slate-300 text-tsu-600"> Cetak nama & jabatan di bawah TTD</label>
          <input type="file" name="image" accept="image/png" required class="block w-full text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-tsu-50 file:px-3 file:py-2 file:font-semibold file:text-tsu-700 hover:file:bg-tsu-100">
          <button class="btn btn-outline w-full">+ Tambah Tanda Tangan</button>
        </form>
      <% } %>
    </div>

    <div class="card">
      <h2 class="font-bold text-slate-900">Logo (<%= event.logos.length %>)</h2>
      <p class="mt-1 text-sm text-slate-500">Tambahkan logo sebanyak yang diperlukan (TSU, Prodi, HMP, mitra/sponsor), lalu atur posisi &amp; ukurannya di Builder.</p>
      <ul class="mt-4 space-y-3">
        <% if (!event.logos.length) { %><li class="rounded-lg border border-dashed border-slate-300 p-4 text-center text-sm text-slate-500">Belum ada logo.</li><% } %>
        <% event.logos.forEach((l) => { %>
          <li class="flex items-center gap-3 rounded-lg border border-slate-200 p-3">
            <img src="<%= l.imageUrl %>" alt="<%= l.label %>" class="h-12 w-20 rounded bg-[repeating-conic-gradient(#f1f5f9_0_25%,#fff_0_50%)] bg-[length:12px_12px] object-contain">
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-slate-900"><%= l.label %></p>
              <p class="truncate text-xs text-slate-500"><%= l.width %> &times; <%= l.height %> px di sertifikat</p>
            </div>
            <% if (p.editTemplate) { %>
              <button class="rounded-md p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600" data-action="DELETE <%= base %>/logos/<%= l.id %>" data-confirm="Hapus logo &quot;<%= l.label %>&quot;?" data-danger data-ok-label="Hapus" aria-label="Hapus logo <%= l.label %>">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
              </button>
            <% } %>
          </li>
        <% }) %>
      </ul>
      <% if (p.editTemplate && event.logos.length < 10) { %>
        <form class="mt-4 space-y-3 border-t border-slate-100 pt-4" data-upload-form data-url="<%= base %>/logos" data-field="image">
          <div>
            <label class="form-label" for="logo-label">Nama logo <span class="text-red-600">*</span></label>
            <input id="logo-label" name="label" required maxlength="100" class="form-input" placeholder="mis. Logo TSU / Logo HMIF / Sponsor">
          </div>
          <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/svg+xml" required class="block w-full text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-tsu-50 file:px-3 file:py-2 file:font-semibold file:text-tsu-700 hover:file:bg-tsu-100">
          <p class="text-xs text-slate-500">PNG transparan atau SVG paling bagus. JPG/WEBP juga diterima (latar putih akan ikut tercetak). Maks. 5 MB, 10 logo per event.</p>
          <button class="btn btn-outline w-full">+ Tambah Logo</button>
        </form>
      <% } %>
    </div>
    </div>
  </section>

  <!-- TAB: Peserta -->
  <section data-tab-panel="peserta" class="hidden space-y-6 pt-6">
    <% if (issued) { const is = event.stats.issue; const unsent = (email.PENDING || 0) + (email.QUEUED || 0); %>
      <div class="card" data-blast-panel data-url="<%= base %>/blast">
        <div>
          <h2 class="font-bold text-slate-900">Manajemen Penerbitan &amp; Email</h2>
          <p class="mt-1 text-sm text-slate-500">Sertifikat yang <strong>terbit</strong> dapat diakses peserta via web (verifikasi QR, pencarian, unduh). Pengiriman <strong>email</strong> terpisah dan hanya dilakukan bila diperlukan.</p>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <!-- Status penerbitan -->
          <section class="rounded-xl border border-slate-200 p-4">
            <h3 class="text-xs font-bold uppercase tracking-wide text-slate-500">Status Penerbitan</h3>
            <dl class="mt-3 grid grid-cols-3 gap-2 text-center">
              <% [['Terbit', is.issued, 'text-emerald-700', 'issued'], ['Belum terbit', is.unissued, 'text-slate-700', 'unissued'], ['Dicabut', is.revoked, 'text-red-700', 'revoked']].forEach(([l, n, cls, key]) => { %>
                <a href="?tab=peserta&issueStatus=<%= key %>" class="rounded-lg bg-slate-50 px-2 py-2 hover:bg-tsu-50 <%= query.issueStatus === key ? 'ring-2 ring-tsu-400' : '' %>">
                  <dd class="text-2xl font-bold tabular-nums <%= cls %>"><%= n %></dd><dt class="text-xs text-slate-500"><%= l %></dt>
                </a>
              <% }) %>
            </dl>
            <% if (p.issue && is.unissued) { %>
              <button class="btn btn-accent mt-3 w-full" data-preview-issue="unissued" data-url="<%= base %>/participants/issue" data-body='<%= json({}) %>' data-total="<%= is.unissued %>" data-confirm-label="Terbitkan">Terbitkan Semua yang Belum (<%= is.unissued %>)</button>
            <% } %>
          </section>

          <!-- Status email -->
          <section class="rounded-xl border border-slate-200 p-4">
            <h3 class="text-xs font-bold uppercase tracking-wide text-slate-500">Status Email <span class="font-normal normal-case">(dari <%= is.issued + is.revoked %> sertifikat terbit)</span></h3>
            <dl class="mt-3 grid grid-cols-4 gap-2 text-center" data-blast-summary>
              <% [['Terkirim', email.SENT || 0, 'text-emerald-700', 'SENT'], ['Belum', email.PENDING || 0, 'text-slate-700', 'PENDING'], ['Antre', email.QUEUED || 0, 'text-sky-700', 'QUEUED'], ['Gagal', email.FAILED || 0, 'text-red-700', 'FAILED']].forEach(([l, n, cls, key]) => { %>
                <a href="?tab=peserta&emailStatus=<%= key %>" class="rounded-lg bg-slate-50 px-1 py-2 hover:bg-tsu-50 <%= query.emailStatus === key ? 'ring-2 ring-tsu-400' : '' %>">
                  <dd class="text-2xl font-bold tabular-nums <%= cls %>" data-email-count="<%= key %>"><%= n %></dd><dt class="text-xs text-slate-500"><%= l %></dt>
                </a>
              <% }) %>
            </dl>
            <% if (p.blast) { %>
              <div class="mt-3 flex flex-wrap gap-2">
                <% if (unsent) { %><button class="btn btn-primary flex-1" data-action="POST <%= base %>/blast" data-body='<%= json({ scope: "pending" }) %>' data-confirm="Kirim email ke <%= unsent %> peserta terbit yang belum menerima email?" data-ok-label="Kirim">Kirim ke yang Belum (<%= unsent %>)</button><% } %>
                <% if (email.FAILED) { %><button class="btn btn-outline flex-1" data-action="POST <%= base %>/blast" data-body='<%= json({ scope: "failed" }) %>' data-confirm="Kirim ulang <%= email.FAILED %> email yang gagal?" data-ok-label="Kirim ulang">Kirim Ulang yang Gagal</button><% } %>
                <% if (is.issued) { %><button class="btn btn-outline flex-1" data-action="POST <%= base %>/blast" data-body='<%= json({ scope: "all" }) %>' data-confirm="Kirim ulang email ke SEMUA peserta terbit (termasuk yang sudah menerima)?" data-ok-label="Kirim semua">Kirim Ulang Semua</button><% } %>
              </div>
            <% } %>
          </section>
        </div>

        <div class="mt-4 hidden" data-blast-progress>
          <div class="flex justify-between text-xs text-slate-600"><span>Mengirim email...</span><span data-blast-count></span></div>
          <progress class="mt-1 h-2 w-full overflow-hidden rounded-full [&::-webkit-progress-bar]:bg-slate-100 [&::-webkit-progress-value]:bg-tsu-600 [&::-moz-progress-bar]:bg-tsu-600" max="100" value="0" data-blast-bar></progress>
        </div>
      </div>
    <% } %>

    <% if (p.editParticipants) { %>
      <div class="card">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="font-bold text-slate-900">Import Peserta (Excel / CSV)</h2>
            <p class="mt-1 text-sm text-slate-500">Unggah file <strong>.xlsx</strong> (disarankan) atau <strong>.csv</strong> dengan susunan kolom berikut. Baris pertama berisi judul kolom.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href="/api/events/participants/xlsx-template" class="btn btn-primary">Unduh Template Excel</a>
            <a href="/api/events/participants/csv-template" class="btn btn-outline">Template CSV</a>
          </div>
        </div>
        <div class="mt-4 overflow-x-auto rounded-lg border border-slate-200">
          <table class="w-full min-w-[40rem] text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-3 py-2 font-semibold">A &middot; nama <span class="text-red-600">*</span></th>
                <th class="px-3 py-2 font-semibold">B &middot; email <span class="text-red-600">*</span></th>
                <th class="px-3 py-2 font-semibold">C &middot; peran</th>
                <th class="px-3 py-2 font-semibold">D &middot; instansi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <tr>
                <td class="px-3 py-2">Dziky Ridhwanullah, S.Kom., M.Kom</td>
                <td class="px-3 py-2">dziky@tsu.ac.id</td>
                <td class="px-3 py-2">Peserta</td>
                <td class="px-3 py-2">Universitas Tiga Serangkai</td>
              </tr>
              <tr class="text-xs text-slate-500">
                <td class="px-3 py-2">Wajib. Tulis lengkap dengan gelar, persis seperti di sertifikat.</td>
                <td class="px-3 py-2">Wajib. Tujuan pengiriman sertifikat.</td>
                <td class="px-3 py-2">Opsional, default &ldquo;Peserta&rdquo;.</td>
                <td class="px-3 py-2">Opsional.</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-xs text-slate-500">Untuk CSV: pemisah koma, titik koma, atau tab dikenali otomatis. Nama bergelar yang mengandung koma sebaiknya diapit tanda kutip (<code class="rounded bg-slate-100 px-1">"Dziky Ridhwanullah, S.Kom., M.Kom"</code>); bila lupa, sistem menggabungkannya otomatis berdasarkan posisi kolom email.</p>
        <form class="mt-4 flex flex-wrap items-center gap-3" data-upload-form data-url="<%= base %>/participants/import" data-field="file" data-report>
          <input type="file" name="file" accept=".xlsx,.csv,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required class="text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-tsu-50 file:px-3 file:py-2 file:font-semibold file:text-tsu-700 hover:file:bg-tsu-100">
          <button class="btn btn-primary">Import</button>
        </form>
        <div class="mt-4 hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900" data-import-report></div>
      </div>
    <% } %>

    <div class="card overflow-hidden p-0">
      <form method="get" class="flex flex-wrap items-center gap-3 border-b border-slate-200 p-4" role="search">
        <input name="q" value="<%= query.q || '' %>" maxlength="120" class="form-input max-w-xs" placeholder="Cari nama, email, nomor..." aria-label="Cari peserta">
        <% if (issued) { %>
          <select name="issueStatus" class="form-input max-w-48" aria-label="Filter status penerbitan">
            <option value="">Semua status terbit</option>
            <% [['issued', 'Terbit'], ['unissued', 'Belum terbit'], ['revoked', 'Dicabut']].forEach(([k, l]) => { %><option value="<%= k %>" <%= query.issueStatus === k ? 'selected' : '' %>><%= l %></option><% }) %>
          </select>
          <select name="emailStatus" class="form-input max-w-48" aria-label="Filter status email">
            <option value="">Semua status email</option>
            <% Object.entries(EMAIL_STATUS_META).forEach(([k, m]) => { %><option value="<%= k %>" <%= query.emailStatus === k ? 'selected' : '' %>><%= m.label %></option><% }) %>
          </select>
        <% } %>
        <input type="hidden" name="tab" value="peserta">
        <button class="btn btn-outline">Cari</button>
        <p class="ml-auto text-sm text-slate-500"><%= participants.pagination.total %> peserta<%= participants.pagination.total > participants.items.length ? ` (menampilkan ${participants.items.length})` : '' %></p>
      </form>
      <% if (issued && (p.issue || p.blast)) { %>
        <!-- Toolbar aksi massal penerbitan / email -->
        <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 bg-slate-50/60 px-4 py-3" data-bulk-bar data-issue-url="<%= base %>/participants/issue" data-blast-url="<%= base %>/blast">
          <span class="text-sm text-slate-600" data-bulk-count aria-live="polite">Centang peserta untuk aksi massal.</span>
          <div class="ml-auto flex flex-wrap gap-2">
            <% if (p.issue) { %>
              <button type="button" class="btn btn-accent py-2 disabled:cursor-not-allowed disabled:opacity-40" data-bulk-issue disabled>Terbitkan Terpilih</button>
            <% } %>
            <% if (p.blast) { %>
              <button type="button" class="btn btn-primary py-2 disabled:cursor-not-allowed disabled:opacity-40" data-bulk-email disabled>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
                Kirim Email Terpilih
              </button>
            <% } %>
          </div>
        </div>
      <% } %>
      <% if (p.editParticipants) { %>
        <!-- Toolbar kelola peserta -->
        <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 bg-slate-50/60 px-4 py-3" data-bulk-bar data-url="<%= base %>/participants/bulk-delete">
          <button type="button" class="btn btn-primary py-2" data-toggle="add-participant" aria-expanded="false" aria-controls="add-participant">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Tambah Peserta
          </button>
          <span class="ml-auto text-sm text-slate-600" data-bulk-count aria-live="polite"></span>
          <button type="button" class="btn py-2 text-red-600 ring-1 ring-red-200 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-40 disabled:ring-slate-200" data-bulk-delete disabled>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            Hapus Terpilih
          </button>
          <% if (event.stats.participants) { %>
            <button type="button" class="btn bg-red-600 py-2 text-white hover:bg-red-700" data-action="DELETE <%= base %>/participants" data-confirm="Hapus SEMUA <%= event.stats.participants %> peserta event ini? Nomor sertifikat akan dimulai dari awal. Tindakan ini tidak dapat dibatalkan." data-confirm-title="Hapus semua peserta?" data-danger data-ok-label="Hapus semua" title="Hapus semua peserta">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
              Hapus Semua
            </button>
          <% } %>
        </div>

        <!-- Form tambah peserta manual -->
        <form id="add-participant" class="hidden border-b border-slate-200 bg-tsu-50/40 p-4" data-api-form data-method="POST" action="<%= base %>/participants" autocomplete="off">
          <h3 class="font-semibold text-slate-900">Tambah Peserta Baru</h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div><label class="form-label" for="ap-name">Nama <span class="text-red-600">*</span></label><input id="ap-name" name="name" required maxlength="150" class="form-input" placeholder="Dziky Ridhwanullah, S.Kom., M.Kom"></div>
            <div><label class="form-label" for="ap-email">Email <span class="text-red-600">*</span></label><input id="ap-email" name="email" type="email" required maxlength="191" class="form-input" placeholder="nama@tsu.ac.id"></div>
            <div>
              <label class="form-label" for="ap-role">Peran</label>
              <input id="ap-role" name="role" maxlength="60" class="form-input" placeholder="Peserta" list="role-options">
              <datalist id="role-options"><% ['Peserta', 'Pembicara', 'Moderator', 'Panitia', 'Juri', 'Pemenang'].forEach((r) => { %><option value="<%= r %>"><% }) %></datalist>
            </div>
            <div><label class="form-label" for="ap-inst">Instansi</label><input id="ap-inst" name="institution" maxlength="150" class="form-input" placeholder="Universitas Tiga Serangkai"></div>
          </div>
          <div class="mt-3 flex flex-wrap items-center justify-end gap-2">
            <p class="mr-auto text-xs text-slate-500">Nomor sertifikat dibuat otomatis melanjutkan urutan terakhir. Peran kosong = &ldquo;Peserta&rdquo;.</p>
            <button type="button" class="btn btn-outline" data-toggle="add-participant">Batal</button>
            <button type="submit" class="btn btn-primary">Simpan Peserta</button>
          </div>
        </form>
      <% } %>
      <% if (!participants.items.length) { %>
        <p class="p-8 text-center text-sm text-slate-500"><%= query.q || query.emailStatus ? 'Tidak ada peserta yang cocok.' : 'Belum ada peserta. Import file CSV di atas.' %></p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
              <tr>
                <% if (p.editParticipants || (issued && (p.issue || p.blast))) { %>
                  <th class="w-10 px-4 py-3"><input type="checkbox" class="rounded border-slate-300 text-tsu-600" data-select-all aria-label="Pilih semua peserta yang ditampilkan"></th>
                <% } %>
                <th class="px-4 py-3">No. Sertifikat</th><th class="px-4 py-3">Nama</th><th class="px-4 py-3">Email</th><th class="px-4 py-3">Peran</th>
                <% if (issued) { %><th class="px-4 py-3">Penerbitan</th><th class="px-4 py-3">Status Email</th><th class="px-4 py-3 text-right">Unduh</th><% } %>
                <th class="px-4 py-3"><span class="sr-only">Aksi</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% participants.items.forEach((c) => { const em = EMAIL_STATUS_META[c.emailStatus]; %>
                <tr class="<%= c.status === 'REVOKED' ? 'bg-red-50/50 text-slate-400' : 'hover:bg-slate-50' %> has-[:checked]:bg-tsu-50" data-row data-id="<%= c.id %>" data-name="<%= c.participantName %>" data-email="<%= c.participantEmail %>" data-role="<%= c.participantRole %>" data-number="<%= c.certificateNumber %>" data-issued="<%= c.issuedAt ? '1' : '0' %>" data-active="<%= c.status === 'ACTIVE' ? '1' : '0' %>">
                  <% if (p.editParticipants || (issued && (p.issue || p.blast))) { %>
                    <td class="px-4 py-2.5"><input type="checkbox" value="<%= c.id %>" class="rounded border-slate-300 text-tsu-600" data-select-row data-issued="<%= c.issuedAt ? '1' : '0' %>" data-active="<%= c.status === 'ACTIVE' ? '1' : '0' %>" aria-label="Pilih <%= c.participantName %>"></td>
                  <% } %>
                  <td class="whitespace-nowrap px-4 py-2.5 font-mono text-xs"><%= c.certificateNumber %></td>
                  <td class="px-4 py-2.5 font-medium <%= c.status === 'REVOKED' ? 'line-through' : 'text-slate-900' %>"><%= c.participantName %><% if (c.institution) { %><span class="block text-xs font-normal text-slate-500"><%= c.institution %></span><% } %></td>
                  <td class="px-4 py-2.5 text-slate-600"><%= c.participantEmail %></td>
                  <td class="px-4 py-2.5 text-slate-600"><%= c.participantRole %></td>
                  <% if (issued) { %>
                    <td class="whitespace-nowrap px-4 py-2.5">
                      <% if (c.status === 'REVOKED') { %><span class="badge bg-red-100 text-red-700 ring-1 ring-red-300">Dicabut</span>
                      <% } else if (c.issuedAt) { %><span class="badge bg-emerald-50 text-emerald-800 ring-1 ring-emerald-300" title="Terbit <%= fmtDateTime(c.issuedAt) %>">Terbit</span><span class="mt-0.5 block text-[11px] text-slate-500"><%= fmtDate(c.issuedAt) %></span>
                      <% } else { %><span class="badge bg-slate-100 text-slate-600 ring-1 ring-slate-300">Belum terbit</span><% } %>
                    </td>
                    <td class="whitespace-nowrap px-4 py-2.5">
                      <% if (!c.issuedAt) { %><span class="text-xs text-slate-400">&mdash;</span>
                      <% } else { %><span class="badge ring-1 <%= em.cls %>"<% if (c.emailError) { %> title="<%= c.emailError %>"<% } %>><%= em.label %></span><% if (c.emailSentAt && c.emailStatus === 'SENT') { %><span class="mt-0.5 block text-[11px] text-slate-500"><%= fmtDate(c.emailSentAt) %></span><% } %><% if (c.emailStatus === 'FAILED' && c.emailError) { %><span class="mt-0.5 block max-w-48 truncate text-[11px] text-red-600" title="<%= c.emailError %>"><%= c.emailError %></span><% } %><% } %>
                    </td>
                    <td class="px-4 py-2.5 text-right tabular-nums"><%= c.downloadCount %></td>
                  <% } %>
                  <td class="whitespace-nowrap px-4 py-2.5 text-right">
                    <button type="button" class="text-xs font-semibold text-tsu-700 hover:underline" data-preview-row="<%= c.id %>">Pratinjau</button>
                    <% if (p.downloadPdf && c.issuedAt) { %><a href="<%= base %>/participants/<%= c.id %>/pdf" target="_blank" rel="noopener" class="ml-3 text-xs font-semibold text-tsu-700 hover:underline">PDF</a><% } %>
                    <% if (issued && c.status === 'ACTIVE' && c.issuedAt) { %>
                      <a href="/verify/<%= c.verificationCode %>" target="_blank" rel="noopener" class="ml-3 text-xs font-semibold text-tsu-700 hover:underline">Verifikasi</a>
                    <% } %>
                    <% if (issued && p.issue && !c.issuedAt && c.status === 'ACTIVE') { %>
                      <button class="ml-3 text-xs font-semibold text-emerald-700 hover:underline" data-preview-issue="one" data-id="<%= c.id %>" data-url="<%= base %>/participants/issue" data-body='<%= json({ ids: [c.id] }) %>' data-confirm-label="Terbitkan">Terbitkan</button>
                    <% } %>
                    <% if (p.editParticipants) { %>
                      <button type="button" class="ml-3 text-xs font-semibold text-tsu-700 hover:underline" data-edit-participant='<%= json({ id: c.id, name: c.participantName, email: c.participantEmail, role: c.participantRole, institution: c.institution || "" }) %>'>Edit</button>
                      <button class="ml-3 text-xs font-semibold text-red-600 hover:underline" data-action="DELETE <%= base %>/participants/<%= c.id %>" data-confirm="Hapus <%= c.participantName %> dari daftar peserta?" data-danger data-ok-label="Hapus">Hapus</button>
                    <% } %>
                    <% if ((p.revoke || p.blast) && c.issuedAt) { %>
                      <% if (c.status === 'ACTIVE') { %>
                        <% if (p.revoke) { %><button class="ml-3 text-xs font-semibold text-red-600 hover:underline" data-action="POST <%= base %>/participants/<%= c.id %>/revoke" data-confirm="Cabut sertifikat <%= c.certificateNumber %>? Halaman verifikasi akan menyatakannya TIDAK VALID dan PDF tidak bisa diunduh." data-danger data-ok-label="Cabut">Cabut</button><% } %>
                        <% if (p.blast) { %><button class="ml-3 text-xs font-semibold text-tsu-700 hover:underline" data-action="POST <%= base %>/blast" data-body='<%= json({ certificateIds: [c.id] }) %>' data-confirm="Kirim sertifikat ke <%= c.participantEmail %>?" data-ok-label="Kirim"><%= c.emailStatus === 'SENT' ? 'Kirim ulang' : 'Kirim email' %></button><% } %>
                      <% } else if (p.revoke) { %>
                        <button class="ml-3 text-xs font-semibold text-tsu-700 hover:underline" data-action="POST <%= base %>/participants/<%= c.id %>/restore" data-confirm="Aktifkan kembali sertifikat ini?" data-ok-label="Aktifkan">Aktifkan</button>
                      <% } %>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>


    <% if (p.editParticipants) { %>
      <!-- Dialog edit peserta -->
      <dialog id="edit-participant" class="m-auto w-[min(32rem,calc(100vw-2rem))] rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50" data-base-url="<%= base %>/participants">
        <form class="space-y-4 p-6" data-edit-form autocomplete="off">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-bold text-slate-900">Edit Data Peserta</h3>
              <p class="text-xs text-slate-500">Nomor sertifikat tidak berubah.</p>
            </div>
            <button type="button" class="rounded-md p-1 text-slate-400 hover:bg-slate-100" data-edit-cancel aria-label="Tutup">&times;</button>
          </div>
          <div><label class="form-label" for="ep-name">Nama <span class="text-red-600">*</span></label><input id="ep-name" name="name" required maxlength="150" class="form-input"></div>
          <div><label class="form-label" for="ep-email">Email <span class="text-red-600">*</span></label><input id="ep-email" name="email" type="email" required maxlength="191" class="form-input"></div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div><label class="form-label" for="ep-role">Peran</label><input id="ep-role" name="role" maxlength="60" class="form-input" list="role-options" placeholder="Peserta"></div>
            <div><label class="form-label" for="ep-inst">Instansi</label><input id="ep-inst" name="institution" maxlength="150" class="form-input"></div>
          </div>
          <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
            <button type="button" class="btn btn-outline" data-edit-cancel>Batal</button>
            <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
          </div>
        </form>
      </dialog>
    <% } %>
  </section>

  <!-- TAB: Info -->
  <section data-tab-panel="info" class="hidden pt-6">
    <div class="card max-w-3xl">
      <%- include('form', { event }) %>
      <% if (!p.edit) { %><p class="mt-4 rounded-lg bg-slate-50 p-3 text-sm text-slate-500">Info event terkunci pada status <strong><%= meta.label %></strong>.</p><% } %>
    </div>
    <% if (p.deleteEvent) { %>
      <div class="mt-6 max-w-3xl rounded-2xl border border-red-200 bg-white p-6">
        <h2 class="font-bold text-red-700">Hapus Event</h2>
        <p class="mt-1 text-sm text-slate-600">Menghapus event beserta template, tanda tangan, dan seluruh data peserta. Tindakan ini tidak dapat dibatalkan.</p>
        <button class="btn mt-4 bg-red-600 text-white hover:bg-red-700" data-action="DELETE <%= base %>" data-confirm="Hapus event &quot;<%= event.title %>&quot; secara permanen?" data-danger data-ok-label="Hapus permanen" data-redirect="/events">Hapus Event</button>
      </div>
    <% } %>
  </section>
</div>

<!-- Dialog pratinjau sertifikat (data asli peserta) sebelum terbit -->
<dialog id="issue-preview" class="m-auto h-[min(52rem,calc(100vh-2rem))] w-[min(72rem,calc(100vw-2rem))] rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/60" data-base-url="<%= base %>/participants">
  <div class="flex h-full flex-col">
    <div class="flex flex-wrap items-center gap-3 border-b border-slate-200 px-5 py-3">
      <div class="min-w-0 flex-1">
        <h3 class="font-bold text-slate-900" data-pv-title>Pratinjau Sertifikat</h3>
        <p class="truncate text-sm text-slate-600" data-pv-who></p>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" class="btn btn-outline px-3 py-1.5" data-pv-prev aria-label="Peserta sebelumnya">&larr;</button>
        <span class="min-w-16 text-center text-sm tabular-nums text-slate-600" data-pv-pos></span>
        <button type="button" class="btn btn-outline px-3 py-1.5" data-pv-next aria-label="Peserta berikutnya">&rarr;</button>
        <a class="btn btn-outline px-3 py-1.5 text-sm" target="_blank" rel="noopener" data-pv-open>Tab baru</a>
        <button type="button" class="rounded-md p-1.5 text-xl leading-none text-slate-400 hover:bg-slate-100" data-pv-close aria-label="Tutup">&times;</button>
      </div>
    </div>
    <div class="relative flex-1 bg-slate-100">
      <iframe class="h-full w-full" title="Pratinjau PDF sertifikat" data-pv-frame></iframe>
    </div>
    <div class="flex flex-wrap items-center gap-3 border-t border-slate-200 px-5 py-3" data-pv-confirm-bar>
      <p class="w-full text-xs text-slate-500" data-pv-note></p>
      <label class="flex items-center gap-2 text-sm font-medium text-slate-800"><input type="checkbox" class="rounded border-slate-300 text-tsu-600" data-pv-check> Saya sudah memeriksa pratinjau dan datanya benar</label>
      <div class="ml-auto flex gap-2">
        <button type="button" class="btn btn-outline" data-pv-close>Batal</button>
        <button type="button" class="btn btn-accent disabled:cursor-not-allowed disabled:opacity-40" data-pv-ok disabled>Terbitkan</button>
      </div>
    </div>
  </div>
</dialog>

<%- include('../../partials/app/end') %>
