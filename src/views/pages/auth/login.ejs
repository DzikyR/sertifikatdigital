<%- include('../../partials/head') %>

<main class="grid flex-1 lg:grid-cols-2">
  <!-- Panel brand -->
  <section class="relative hidden overflow-hidden bg-gradient-to-br from-tsu-800 via-tsu-700 to-tsu-900 p-12 text-white lg:flex lg:flex-col lg:justify-between">
    <div class="absolute -bottom-24 -left-24 h-80 w-80 rounded-full bg-gold-400/20 blur-3xl"></div>
    <a href="/" class="relative flex items-center gap-3">
      <%- include('../../partials/brand-logo', { size: 'lg' }) %>
      <span class="font-bold"><%= brand.appName %></span>
    </a>
    <div class="relative">
      <h1 class="text-4xl font-extrabold leading-tight"><%= brand.loginTitle %><% if (brand.loginHighlight) { %><br><span class="text-gold-400"><%= brand.loginHighlight %></span><% } %></h1>
      <% if (brand.loginDescription) { %><p class="mt-4 max-w-md whitespace-pre-line text-tsu-100"><%= brand.loginDescription %></p><% } %>
    </div>
    <p class="relative text-sm text-tsu-300">&copy; <%= currentYear %> <%= brand.footerCopyright %></p>
  </section>

  <!-- Form login -->
  <section class="flex items-center justify-center px-4 py-12 sm:px-8">
    <div class="w-full max-w-md">
      <a href="/" class="mb-8 flex items-center gap-3 lg:hidden">
        <%- include('../../partials/brand-logo', { tone: 'primary' }) %>
        <span class="font-bold text-tsu-800"><%= brand.appName %></span>
      </a>

      <h2 class="text-2xl font-bold text-slate-900">Masuk ke akun Anda</h2>
      <p class="mt-1 text-sm text-slate-500">Khusus pengelola. Peserta tidak perlu login<% if (feature('public.search')) { %> &mdash; <a href="/cari" class="font-semibold text-tsu-700 hover:underline">cari sertifikat di sini</a><% } %>.</p>

      <div class="mt-6"><%- include('../../partials/flash') %></div>

      <% if (googleEnabled) { %>
        <a href="/auth/google" class="btn btn-outline mt-6 w-full">
          <svg class="h-5 w-5" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
          Masuk dengan Google
        </a>
        <div class="my-6 flex items-center gap-3 text-xs uppercase tracking-wide text-slate-400">
          <span class="h-px flex-1 bg-slate-200"></span>atau<span class="h-px flex-1 bg-slate-200"></span>
        </div>
      <% } %>

      <form action="/auth/login" method="post" class="<%= googleEnabled ? '' : 'mt-6' %> space-y-4" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <div>
          <label for="email" class="form-label">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="191"
                 class="form-input" placeholder="nama@tsu.ac.id" value="<%= oldInput.email || '' %>">
        </div>
        <div>
          <label for="password" class="form-label">Password</label>
          <div class="relative">
            <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128"
                   class="form-input pr-11" placeholder="••••••••">
            <%- include('../../partials/password-toggle') %>
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-full">Masuk</button>
      </form>
    </div>
  </section>
</main>

</body>
</html>
